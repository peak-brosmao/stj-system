# ==============================================================================
# STJ Management System - Environment Variables Configuration
# Production Domains:
#   Frontend: https://itcstudent.space
#   Backend API: https://api.itcstudent.space
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="https://itcstudent.space"

# Laravel Backend API Integration
LARAVEL_API_URL="https://api.itcstudent.space/api"
NEXT_PUBLIC_API_URL="https://api.itcstudent.space/api"

# Session Security & Encryption (Min 32 characters)
JWT_SECRET="stj_jwt_secret_production_key_itc_cambodia_random_secure_hex_2026"

# Localization & Timezone
NEXT_PUBLIC_DEFAULT_LOCALE="km"
TIMEZONE="Asia/Phnom_Penh"

# Application Metadata
NEXT_PUBLIC_APP_NAME="STJ Management System"
NEXT_PUBLIC_INSTITUTION="Institute of Technology of Cambodia"
