# ==============================================================================
# STJ Management System - Environment Variables Configuration
# Institute of Technology of Cambodia (ITC)
# Hostinger Business/Unlimited Web Hosting Compatible (MySQL & Node.js)
# ==============================================================================

# Database Connection (MySQL on Hostinger or Local MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://stj_user:stj_secure_password@127.0.0.1:3306/stj_database"

# Session Security & Encryption (Min 32 characters)
JWT_SECRET="stj_jwt_secret_production_key_itc_cambodia_random_secure_hex"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Localization & Timezone
NEXT_PUBLIC_DEFAULT_LOCALE="km"
TIMEZONE="Asia/Phnom_Penh"

# Application Metadata
NEXT_PUBLIC_APP_NAME="STJ Management System"
NEXT_PUBLIC_INSTITUTION="Institute of Technology of Cambodia"

