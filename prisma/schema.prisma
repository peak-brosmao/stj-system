datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  fullNameKh        String
  fullNameEn        String
  displayName       String?
  gender            String?
  dateOfBirth       DateTime?
  bio               String?
  studentId         String?
  phone             String?
  telegram          String?
  address           String?
  profileImage      String?
  preferredLanguage String             @default("km")
  status            String             @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  isSuspended       Boolean            @default(false)
  emailVerified     Boolean            @default(false)
  twoFactorEnabled  Boolean            @default(false)
  lastLoginAt       DateTime?
  memberRecordId    String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  member            Member?            @relation(fields: [memberRecordId], references: [id])
  userRoles         UserRole[]
  courseLeaders     CourseLeader[]
  createdSessions   TeachingSession[]  @relation("CreatedSessions")
  markedAttendances AttendanceRecord[] @relation("MarkedAttendances")
  updatedAttendances AttendanceRecord[] @relation("UpdatedAttendances")
  requestedCorrections AttendanceCorrection[] @relation("RequestedCorrections")
  reviewedCorrections AttendanceCorrection[] @relation("ReviewedCorrections")
  createdShareLinks ShareLink[]        @relation("CreatedShareLinks")
  auditLogs         AuditLog[]
  announcements     Announcement[]
  notifications     Notification[]
  userSessions      UserSession[]
  sentInvitations   Invitation[]
  profileChangeRequests ProfileChangeRequest[] @relation("UserChangeRequests")
  reviewedProfileRequests ProfileChangeRequest[] @relation("AdminReviewedProfileRequests")
  notificationPreferences NotificationPreference?
  loginHistories    LoginHistory[]
  mandates          StjMandate[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // SUPER_ADMIN, STJ_ADMIN, COURSE_LEADER, MEMBER
  description String?
  isSystem    Boolean          @default(true)
  userRoles   UserRole[]
  permissions RolePermission[]
  invitations Invitation[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g., attendance:mark, attendance:read, members:manage
  module      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique // GIC, AMS, GIM, etc.
  nameKh      String
  nameEn      String
  nameFr      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     Member[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  code      String   @unique // I1, I2, I3, I4, I5
  label     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
}

model Member {
  id               String                 @id @default(cuid())
  memberId         String                 @unique // STJ001, STJ002...
  studentId        String?
  fullNameKh       String
  fullNameEn       String
  email            String?
  phone            String?
  gender           String?                // M, F
  departmentId     String
  academicYearId   String
  status           String                 @default("ACTIVE") // ACTIVE, ARCHIVED, SUSPENDED
  cohortYear       String?                @default("2026-2027")
  notes            String?
  registrationDate DateTime               @default(now())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  department       Department             @relation(fields: [departmentId], references: [id])
  academicYear     AcademicYear           @relation(fields: [academicYearId], references: [id])
  enrollments      CourseEnrollment[]
  attendanceRecords AttendanceRecord[]
  activityParticipations ActivityParticipation[]
  user             User?
}

model Course {
  id            String             @id @default(cuid())
  code          String             @unique // PROG101, MATH101
  slug          String             @unique // programming, mathematics
  titleKh       String
  titleEn       String
  titleFr       String
  descriptionKh String
  descriptionEn String
  descriptionFr String
  category      String             // Engineering Foundation, Advanced Computing
  icon          String             @default("BookOpen") // Lucide icon identifier
  coverImage    String?
  status        String             @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT
  academicTerm  String?            // 2026-2027 Semester 1
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  leaders       CourseLeader[]
  enrollments   CourseEnrollment[]
  sessions      TeachingSession[]
  shareLinks    ShareLink[]
  announcements Announcement[]
}

model CourseLeader {
  id         String   @id @default(cuid())
  courseId   String
  userId     String
  assignedAt DateTime @default(now())

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model CourseEnrollment {
  id         String   @id @default(cuid())
  courseId   String
  memberId   String
  enrolledAt DateTime @default(now())
  status     String   @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([courseId, memberId])
}

model TeachingSession {
  id          String             @id @default(cuid())
  courseId    String
  title       String
  sessionDate DateTime
  startTime   String             // 08:00
  endTime     String             // 10:00
  room        String             // Campus 1, Building A, Room 204
  status      String             @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  notes       String?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("CreatedSessions", fields: [createdById], references: [id])
  attendance  AttendanceRecord[]
  shareLinks  ShareLink[]
}

model AttendanceRecord {
  id              String                 @id @default(cuid())
  sessionId       String
  memberId        String
  status          String                 // PRESENT, LATE, ABSENT, EXCUSED
  remarks         String?
  markedById      String
  markedAt        DateTime               @default(now())
  lastUpdatedById String?
  updatedAt       DateTime               @updatedAt

  session         TeachingSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member          Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  markedBy        User                   @relation("MarkedAttendances", fields: [markedById], references: [id])
  lastUpdatedBy   User?                  @relation("UpdatedAttendances", fields: [lastUpdatedById], references: [id])
  corrections     AttendanceCorrection[]

  @@unique([sessionId, memberId])
}

model AttendanceCorrection {
  id              String           @id @default(cuid())
  recordId        String
  requestedById   String
  previousStatus  String
  requestedStatus String
  reason          String
  attachmentUrl   String?
  reviewStatus    String           @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById    String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  record          AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  requestedBy     User             @relation("RequestedCorrections", fields: [requestedById], references: [id])
  reviewedBy      User?            @relation("ReviewedCorrections", fields: [reviewedById], references: [id])
}

model ShareLink {
  id           String            @id @default(cuid())
  token        String            @unique
  tokenHash    String
  courseId     String
  sessionId    String?
  title        String
  passwordHash String?
  expiresAt    DateTime?
  isRevoked    Boolean           @default(false)
  accessCount  Int               @default(0)
  showStats    Boolean           @default(true)
  fieldsConfig String            @default("{}") // JSON string of displayed columns
  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session      TeachingSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("CreatedShareLinks", fields: [createdById], references: [id])
  accessLogs   ShareLinkAccess[]
}

model ShareLinkAccess {
  id          String    @id @default(cuid())
  shareLinkId String
  ipAddress   String?
  userAgent   String?
  accessedAt  DateTime  @default(now())

  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           String    @id @default(cuid())
  titleKh      String
  titleEn      String
  titleFr      String
  contentKh    String
  contentEn    String
  contentFr    String
  scope        String    @default("GLOBAL") // GLOBAL, COURSE, DEPARTMENT
  courseId     String?
  isPublished  Boolean   @default(true)
  publishedAt  DateTime  @default(now())
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course       Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy    User      @relation(fields: [createdById], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  category  String   @default("ANNOUNCEMENT") // ANNOUNCEMENT, COURSE, SESSION, CORRECTION, SECURITY
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id            String                  @id @default(cuid())
  titleKh       String
  titleEn       String
  titleFr       String
  descriptionKh String
  descriptionEn String
  descriptionFr String
  location      String
  category      String                  // WORKSHOP, SEMINAR, TUTORING, COMPETITION
  status        String                  @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  participants  ActivityParticipation[]
}

model ActivityParticipation {
  id           String   @id @default(cuid())
  activityId   String
  memberId     String
  role         String   @default("PARTICIPANT") // PARTICIPANT, ORGANIZER, VOLUNTEER
  registeredAt DateTime @default(now())

  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([activityId, memberId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // LOGIN, ATTENDANCE_MARKED, RECORD_CORRECTED, SHARE_LINK_REVOKED
  entityType String   // ATTENDANCE, MEMBER, USER, COURSE, SYSTEM
  entityId   String?
  details    String   // JSON payload string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Translation {
  id        String   @id @default(cuid())
  locale    String   // km, fr, en
  namespace String   // common, navigation, attendance, etc.
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String    @unique
  roleId      String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  role        Role      @relation(fields: [roleId], references: [id])
  createdBy   User      @relation(fields: [createdById], references: [id])
}

model ProfileChangeRequest {
  id             String    @id @default(cuid())
  userId         String
  field          String    // fullNameKh, fullNameEn, studentId, department, academicYear
  oldValue       String?
  requestedValue String
  reason         String
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById   String?
  reviewNotes    String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation("UserChangeRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?     @relation("AdminReviewedProfileRequests", fields: [reviewedById], references: [id])
}

model NotificationPreference {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  stjAnnouncements           Boolean  @default(true)
  courseAnnouncements        Boolean  @default(true)
  newSessions                Boolean  @default(true)
  scheduleChanges            Boolean  @default(true)
  attendanceCorrectionUpdates Boolean @default(true)
  profileCorrectionUpdates   Boolean  @default(true)
  emailNotifications         Boolean  @default(false)
  updatedAt                  DateTime @updatedAt

  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  status    String   @default("SUCCESS") // SUCCESS, FAILED
  loginAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StjMandate {
  id                 String    @id @default(cuid())
  academicYear       String    @unique // e.g. "2026-2027", "2027-2028"
  titleKh            String    // អាណត្តិដឹកនាំ STJ ឆ្នាំសិក្សា ២០២៦-២០២៧
  presidentId        String    // User ID of the STJ President
  presidentNameKh    String    // ផល ដាវីត
  presidentStudentId String    // e20221334
  status             String    @default("ACTIVE") // ACTIVE, ARCHIVED, HANDED_OVER
  isLocked           Boolean   @default(false)    // When archived/locked, previous year data cannot be mutated
  startDate          DateTime  @default(now())
  endDate            DateTime?
  handoverDate       DateTime?
  handoverNotes      String?
  successorId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  president          User      @relation(fields: [presidentId], references: [id])
}

